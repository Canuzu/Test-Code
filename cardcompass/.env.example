# CardCompass – Build-Konfiguration (als .env.production neben package.json anlegen).
# Alle Werte hier sind ÖFFENTLICH (landen im Website-Code). Geheime Schlüssel
# (Stripe Secret Key, Webhook-Secret, Service-Role-Key) gehören NIE hierher,
# sondern nur in die Supabase-Secrets (siehe docs/STRIPE-SETUP.md).

# Supabase-Projekt (Dashboard → Project Settings → API)
VITE_SUPABASE_URL=https://<projekt-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Erst auf 1 setzen, wenn die Stripe-Funktionen deployt und getestet sind.
VITE_STRIPE_ENABLED=0

# Betreiberangaben für Impressum, Kontakt, Widerruf und Datenschutz.
# Alternativ direkt in src/content/operator.js eintragen. Über diese Variablen
# bleiben die Daten aus dem öffentlichen Code-Repository heraus.
VITE_OPERATOR_NAME=
VITE_OPERATOR_STREET=
VITE_OPERATOR_CITY=
VITE_OPERATOR_EMAIL=
VITE_OPERATOR_PHONE=
# Nur falls vorhanden (nicht für Kleinunternehmer nach § 19 UStG):
VITE_OPERATOR_VAT_ID=
